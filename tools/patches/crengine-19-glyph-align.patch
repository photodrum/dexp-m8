+     */
+    static void * allocItem( size_t size )
+    {
+#if defined(_WIN32) || defined(__SYMBIAN32__)
+        return malloc( size );
+#else
+        void * p = NULL;
+        if ( posix_memalign( &p, alignof(LVFontGlyphCacheItem), size ) != 0 )
+            return NULL;
+        return p;
+#endif
