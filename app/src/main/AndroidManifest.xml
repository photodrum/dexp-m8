<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Wi-Fi и сетевые каталоги (OPDS/SMB) появятся на этапе B14–B16 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Чтение книг: сканер /sdcard/Books и MediaStore (core/Scanner.kt).
         Опасное разрешение — запрашивается во время работы (EinkActivity.requestStorage). -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- Та же группа STORAGE, выдаётся тем же диалогом. Нужно для записи DexpM8-crash.txt
         в корень внутреннего хранилища: стек падения открывается файловым менеджером книги. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- Шаг 4.6, общий слой core/Sys.kt (B37–B42 и панель B5).
         WRITE_SETTINGS — особое право: выдаётся на системном экране (EinkActivity.withWriteSettings).
         Остальные — обычные, выдаются при установке. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="false"
        android:supportsRtl="false"
        android:theme="@style/Theme.DexpM8">

        <activity
            android:name=".ui.EinkActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|fontScale"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateAlwaysHidden|adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- HOME-замена: ставится из настроек оболочки, а не как единственный лаунчер -->
        <activity-alias
            android:name=".ui.HomeAlias"
            android:exported="true"
            android:targetActivity=".ui.EinkActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Device admin только для сна по кнопке (core/AdminReceiver.kt, B5) -->
        <receiver
            android:name=".core.AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Служба спецвозможностей только для меню питания (core/PowerService.kt, «Выключение» на B5).
             Включается пользователем в «Спец. возможностях»; система подключается по BIND_ACCESSIBILITY_SERVICE. -->
        <service
            android:name=".core.PowerService"
            android:exported="true"
            android:label="@string/power_service"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/power_service" />
        </service>

    </application>

</manifest>
